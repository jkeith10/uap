# UAP Configuration Example
# Copy this file to .env and update the values

# Environment
UAP_ENVIRONMENT=development  # development, staging, production, testing
UAP_DEBUG=true
UAP_SERVICE_NAME=uap
UAP_SERVICE_VERSION=1.0.0

# Service
UAP_HOST=0.0.0.0
UAP_PORT=8000

# Database Configuration
UAP_DATABASE__HOST=localhost
UAP_DATABASE__PORT=5432
UAP_DATABASE__NAME=uap
UAP_DATABASE__USER=uap
UAP_DATABASE__PASSWORD=uap_password
UAP_DATABASE__POOL_SIZE=10
UAP_DATABASE__MAX_OVERFLOW=20
UAP_DATABASE__POOL_TIMEOUT=30
UAP_DATABASE__POOL_RECYCLE=3600

# Redis Configuration
UAP_REDIS__HOST=localhost
UAP_REDIS__PORT=6379
UAP_REDIS__DB=0
UAP_REDIS__PASSWORD=
UAP_REDIS__MAX_CONNECTIONS=20
UAP_REDIS__SOCKET_TIMEOUT=5
UAP_REDIS__SOCKET_CONNECT_TIMEOUT=5
UAP_REDIS__RETRY_ON_TIMEOUT=true

# Logging Configuration
UAP_LOGGING__LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
UAP_LOGGING__FORMAT=json  # json or console
UAP_LOGGING__INCLUDE_TIMESTAMPS=true
UAP_LOGGING__LOG_FILE=
UAP_LOGGING__MAX_FILE_SIZE=10485760
UAP_LOGGING__BACKUP_COUNT=5

# Security Configuration
UAP_SECURITY__SECRET_KEY=your-secret-key-change-in-production
UAP_SECURITY__JWT_SECRET=your-jwt-secret-change-in-production
UAP_SECURITY__JWT_ALGORITHM=HS256
UAP_SECURITY__JWT_EXPIRATION=3600
UAP_SECURITY__CORS_ORIGINS=*
UAP_SECURITY__RATE_LIMIT_REQUESTS=100
UAP_SECURITY__RATE_LIMIT_WINDOW=60

# Monitoring Configuration
UAP_MONITORING__ENABLE_METRICS=true
UAP_MONITORING__METRICS_PORT=9090
UAP_MONITORING__ENABLE_TRACING=true
UAP_MONITORING__TRACING_ENDPOINT=http://jaeger:14268/api/traces
UAP_MONITORING__HEALTH_CHECK_INTERVAL=30
UAP_MONITORING__ENABLE_PROFILING=false

# Protocol Configuration
UAP_PROTOCOL__MCP_ENABLED=true
UAP_PROTOCOL__A2A_ENABLED=true
UAP_PROTOCOL__ACP_ENABLED=true
UAP_PROTOCOL__DEFAULT_TIMEOUT=30
UAP_PROTOCOL__MAX_RETRIES=3
UAP_PROTOCOL__RETRY_DELAY=1.0

# Reflection Configuration
UAP_REFLECTION__ENABLE_REFLECTION=true
UAP_REFLECTION__REFLECTION_INTERVAL=300
UAP_REFLECTION__MAX_MEMORY_ENTRIES=10000
UAP_REFLECTION__CLEANUP_INTERVAL=3600
UAP_REFLECTION__ENABLE_AUTO_OPTIMIZATION=true

# Feature Flags
UAP_FEATURE_FLAGS__ENABLE_WEBSOCKET=true
UAP_FEATURE_FLAGS__ENABLE_STREAMING=true
UAP_FEATURE_FLAGS__ENABLE_VECTOR_SEARCH=true
UAP_FEATURE_FLAGS__ENABLE_AUTO_ROUTING=true
